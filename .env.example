# 对外访问地址。agent 拿到的链接、技能包里的服务地址都以它开头，必须改成你的服务器地址。
ARTIFACT_PUBLIC_URL=http://your-server-ip:8790

# 构建方式：Dockerfile 在容器里编译（需要约 2 GB 内存）；
# Dockerfile.prebuilt 使用本机 make linux 交叉编译好的二进制，适合小内存服务器
ARTIFACT_DOCKERFILE=Dockerfile

# 宿主机上监听的端口（容器内固定为 8790）
ARTIFACT_HOST_PORT=8790

# 首次启动时创建的管理员
ARTIFACT_ADMIN_USER=admin
# 留空则随机生成，只在首次启动的日志里打印一次（docker compose logs artifact）
ARTIFACT_ADMIN_PASSWORD=

# 磁盘剩余空间低于这个值（MB）时，拒绝新的写入，避免把系统盘写满
ARTIFACT_MIN_FREE_DISK_MB=300

# 单个请求体上限（MB）
ARTIFACT_MAX_BODY_MB=64

# 放在 nginx、Caddy 等反向代理后面时设为 true，才会使用 X-Forwarded-For 识别客户端 IP
ARTIFACT_TRUST_PROXY=false

# 可选：让 artifact 内容使用独立的源（例如另一个子域名指向同一服务），隔离更彻底
# ARTIFACT_CONTENT_ORIGIN=https://content.example.com

# 可选：签名密钥。留空则首次启动时随机生成并保存在数据库中
# ARTIFACT_SECRET=
